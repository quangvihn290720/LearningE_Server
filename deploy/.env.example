# Chỉ tên biến. Tạo file thật bằng deploy/gen-env.ps1 (Windows) hoặc deploy/gen-env.sh. KHÔNG commit .env.
APP_ENV=dev
# Khóa dùng chung giữa các dịch vụ (≥ 32 ký tự)
LEARNINGE_INTERNAL_TOKEN=
# base64 ≥ 32 byte, chỉ auth giữ
LEARNINGE_SERVER_KEY=
# base64 ≥ 32 byte, chỉ auth và sync giữ
LEARNINGE_PSEUDONYM_KEY=
MONGO_ROOT_PASSWORD=
MONGO_CONTENT_PASSWORD=
MONGO_GAME_PASSWORD=
MONGO_INSIGHT_PASSWORD=
# logstash = log JSON; để trống = log thường
LOG_FORMAT=logstash
LOG_LEVEL=INFO
# true chỉ khi APP_ENV=dev, để dùng grpcurl
LEARNINGE_GRPC_REFLECTION=false
EDGE_TRUST_PROXY=false
EDGE_MIN_CLIENT=1
