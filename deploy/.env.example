# Chỉ tên biến. Tạo file thật bằng deploy/gen-env.ps1 (Windows) hoặc deploy/gen-env.sh. KHÔNG commit .env.
APP_ENV=dev
# Khóa dùng chung giữa các dịch vụ (≥ 32 ký tự)
LEARNINGE_INTERNAL_TOKEN=
# base64 ≥ 32 byte, chỉ auth giữ
LEARNINGE_SERVER_KEY=
# base64 ≥ 32 byte, chỉ auth và sync giữ
LEARNINGE_PSEUDONYM_KEY=
MONGO_ROOT_PASSWORD=
MONGO_CONTENT_PASSWORD=
MONGO_GAME_PASSWORD=
MONGO_INSIGHT_PASSWORD=
# logstash = log JSON; để trống = log thường
LOG_FORMAT=logstash
LOG_LEVEL=INFO
# true chỉ khi APP_ENV=dev, để dùng grpcurl
LEARNINGE_GRPC_REFLECTION=false
# true khi có proxy/tunnel (Caddy, cloudflared, ngrok) chạy trên cùng máy đứng trước edge. Để false thì mọi người
# dùng sau proxy bị tính chung một IP và chặn lẫn nhau (Login 5 lần/phút/IP).
EDGE_TRUST_PROXY=false
# Proxy trên máy chủ gọi vào container qua mạng của Docker (172.16.0.0/12). Đổi nếu Docker dùng dải khác.
EDGE_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# Header mang IP thật do proxy ghi: x-forwarded-for (Caddy, ngrok) hoặc cf-connecting-ip (Cloudflare Tunnel)
EDGE_CLIENT_IP_HEADER=x-forwarded-for
EDGE_MIN_CLIENT=1
