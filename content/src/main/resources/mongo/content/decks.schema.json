{
  "bsonType": "object", "additionalProperties": false,
  "required": ["_id", "name", "language_code", "sort_order", "version", "word_count", "updated_at"],
  "properties": {
    "_id": { "bsonType": "string", "pattern": "^[A-Z][0-9]{2}$" },
    "name": { "bsonType": "string", "minLength": 1, "maxLength": 50 },
    "description": { "bsonType": ["string", "null"], "maxLength": 200 },
    "language_code": { "bsonType": "string", "pattern": "^[a-z]{2}$" },
    "level": { "enum": ["A1", "A2", "B1", null] },
    "icon": { "bsonType": ["string", "null"], "maxLength": 40 },
    "exam_tag": { "bsonType": ["string", "null"], "maxLength": 20 },
    "sort_order": { "bsonType": "int" },
    "version": { "bsonType": "int", "minimum": 1 },
    "word_count": { "bsonType": "int", "minimum": 0 },
    "retired": { "bsonType": "bool" },
    "updated_at": { "bsonType": "date" }
  }
}
