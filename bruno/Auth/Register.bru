meta {
  name: Register
  type: grpc
  seq: 1
}

grpc {
  url: {{baseUrl}}
  method: /learninge.app.v1.AuthService/Register
  body: grpc
  auth: none
  methodType: unary
  protoPath: ./protos/learninge/app/v1/auth.proto
}

metadata {
  x-client-version: {{clientVersion}}
}

body:grpc {
  name: message 1
  content: '''
    {
      "email": "{{email}}",
      "password": "{{password}}",
      "nickname": "{{nickname}}",
      "display_name": "{{displayName}}",
      "security_question_id": 1,
      "security_answer": "{{securityAnswer}}",
      "device_name": "{{deviceName}}"
    }
  '''
}

script:grpc:after-message-receive {
  const token = bru.grpc.response.message.data.token;
  if (token) bru.setVar('token', token);
}

docs {
  EP-02. Tạo tài khoản thật trên môi trường đang chọn. Token tự được giữ.
}
