meta {
  name: ChangePassword
  type: grpc
  seq: 3
}

grpc {
  url: {{baseUrl}}
  method: /learninge.app.v1.AuthService/ChangePassword
  body: grpc
  auth: inherit
  methodType: unary
  protoPath: ./protos/learninge/app/v1/auth.proto
}

metadata {
  x-client-version: {{clientVersion}}
}

body:grpc {
  name: message 1
  content: '''
    {
      "current_password": "{{password}}",
      "new_password": "{{newPassword}}",
      "device_name": "{{deviceName}}"
    }
  '''
}

script:grpc:after-message-receive {
  const token = bru.grpc.response.message.data.token;
  if (token) bru.setVar('token', token);
}

docs {
  EP-07. Xong phải sửa biến password trong môi trường.
}
