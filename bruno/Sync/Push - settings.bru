meta {
  name: Push - settings
  type: grpc
  seq: 2
}

grpc {
  url: {{baseUrl}}
  method: /learninge.app.v1.SyncService/Push
  body: grpc
  auth: inherit
  methodType: unary
  protoPath: ./protos/learninge/app/v1/sync.proto
}

metadata {
  x-client-version: {{clientVersion}}
}

body:grpc {
  name: message 1
  content: '''
    {
      "device_id": "{{deviceId}}",
      "changes": [
        {
          "record_id": "",
          "updated_at_ms": "{{nowMs}}",
          "settings": {
            "level": "CEFR_LEVEL_A2",
            "daily_goal": 10
          }
        }
      ]
    }
  '''
}

script:grpc:before-call-start {
  const now = Date.now();
  bru.setVar('nowMs', String(now));
  bru.setVar('today', new Date(now + 7 * 3600 * 1000).toISOString().slice(0, 10));
}

docs {
  EP-11
}
