# Giống định dạng mặc định của IntelliJ IDEA (Ctrl+Alt+L), để mọi máy và mọi IDE ra cùng kết quả.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.java]
ij_continuation_indent_size = 8
ij_java_keep_line_breaks = true

[*.{yml,yaml,json,toml,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
